@model ProjetoGS.Web.Models.CadastroViewModel
@{
    ViewData["Title"] = "Cadastro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Cadastro — ProjetoGS Space</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        body { background: linear-gradient(135deg,#0a0a2e,#1a1a5e,#0d3b6e); min-height:100vh; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-4">
<div class="card shadow-lg border-0 p-4" style="width:100%;max-width:420px;border-radius:16px">
    <div class="text-center mb-4">
        <div class="display-4 mb-2">🛸</div>
        <h3 class="fw-bold" style="color:#0a0a2e">Criar Conta</h3>
        <p class="text-muted small">Junte-se à plataforma espacial</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @Html.ValidationSummary(false)
        </div>
    }

    <form asp-action="Cadastro" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Nome" class="form-label fw-medium">Nome Completo</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <input asp-for="Nome" class="form-control" placeholder="Seu nome"/>
            </div>
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-medium">E-mail</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="seu@email.com"/>
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Senha" class="form-label fw-medium">Senha</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres"/>
            </div>
            <span asp-validation-for="Senha" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
            <i class="bi bi-person-plus me-2"></i>Criar Conta
        </button>
    </form>

    <hr class="my-3"/>
    <p class="text-center text-muted small mb-0">
        Já tem conta? <a asp-action="Login" class="text-decoration-none fw-medium">Entrar</a>
    </p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
