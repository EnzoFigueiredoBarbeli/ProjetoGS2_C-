@model ProjetoGS.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Login — ProjetoGS Space</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        body { background: linear-gradient(135deg,#0a0a2e 0%,#1a1a5e 50%,#0d3b6e 100%); min-height:100vh; }
        .login-card { border-radius: 16px; backdrop-filter: blur(10px); }
        .star { position:fixed; border-radius:50%; background:#fff; animation: twinkle 3s infinite; }
        @@keyframes twinkle { 0%,100%{opacity:.3} 50%{opacity:1} }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">

<!-- Estrelas decorativas -->
<div class="star" style="width:2px;height:2px;top:10%;left:20%;animation-delay:0s"></div>
<div class="star" style="width:3px;height:3px;top:30%;left:70%;animation-delay:1s"></div>
<div class="star" style="width:2px;height:2px;top:60%;left:40%;animation-delay:2s"></div>
<div class="star" style="width:2px;height:2px;top:80%;left:85%;animation-delay:.5s"></div>
<div class="star" style="width:3px;height:3px;top:20%;left:50%;animation-delay:1.5s"></div>

<div class="card login-card shadow-lg border-0 p-4" style="width:100%;max-width:400px;background:rgba(255,255,255,0.97)">
    <div class="text-center mb-4">
        <div class="display-4 mb-2">🚀</div>
        <h3 class="fw-bold" style="color:#0a0a2e">ProjetoGS Space</h3>
        <p class="text-muted small">Nova Economia Espacial — FIAP GS 2026</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @Html.ValidationSummary(false)
        </div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-medium">E-mail</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="seu@email.com" autocomplete="email"/>
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Senha" class="form-label fw-medium">Senha</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="Senha" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password"/>
            </div>
            <span asp-validation-for="Senha" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" style="background:linear-gradient(90deg,#0a0a2e,#1a1a5e);border:none">
            <i class="bi bi-box-arrow-in-right me-2"></i>Entrar
        </button>
    </form>

    <hr class="my-3"/>
    <p class="text-center text-muted small mb-0">
        Não tem conta?
        <a asp-action="Cadastro" class="text-decoration-none fw-medium">Cadastre-se</a>
    </p>
    <div class="mt-3 p-2 bg-light rounded small text-muted">
        <strong>Demo:</strong><br/>
        Admin: admin@projetogs.com / admin123<br/>
        Pesquisador: pesquisador@projetogs.com / pesq123
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
