@model ProjetoGS.Web.Models.StatsViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxTotal = Model.PorCategoria.Any() ? Model.PorCategoria.Max(c => c.Total) : 1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">
            <i class="bi bi-rocket-takeoff me-2 text-primary"></i>Painel de Controle
        </h2>
        <small class="text-muted">Nova Economia Espacial — Tecnologias derivadas do espaço</small>
    </div>
</div>

<!-- Cards de métricas -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg,#0d6efd,#0a58ca)">
            <div class="card-body text-white d-flex align-items-center gap-3">
                <i class="bi bi-cpu fs-1 opacity-75"></i>
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalTecnologias</div>
                    <div class="opacity-75">Tecnologias Catalogadas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg,#198754,#146c43)">
            <div class="card-body text-white d-flex align-items-center gap-3">
                <i class="bi bi-globe2 fs-1 opacity-75"></i>
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalMissoes</div>
                    <div class="opacity-75">Missões Mapeadas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg,#fd7e14,#dc6502)">
            <div class="card-body text-white d-flex align-items-center gap-3">
                <i class="bi bi-diagram-3 fs-1 opacity-75"></i>
                <div>
                    <div class="fs-1 fw-bold">@Model.TotalSetores</div>
                    <div class="opacity-75">Setores Beneficiados</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Gráfico de categorias -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="fw-semibold mb-0">
                    <i class="bi bi-bar-chart me-2 text-primary"></i>Impacto por Setor
                </h5>
                <small class="text-muted">Setores da Terra beneficiados por tecnologias espaciais</small>
            </div>
            <div class="card-body">
                @foreach (var cat in Model.PorCategoria)
                {
                    var pct = maxTotal > 0 ? (double)cat.Total / maxTotal * 100 : 0;
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="small fw-medium">@cat.Categoria</span>
                            <span class="badge bg-primary rounded-pill">@cat.Total</span>
                        </div>
                        <div class="progress" style="height:10px">
                            <div class="progress-bar bg-primary" role="progressbar"
                                 style="width:@pct.ToString("F0")%"></div>
                        </div>
                    </div>
                }
                @if (!Model.PorCategoria.Any())
                {
                    <p class="text-muted text-center py-3">Nenhum dado disponível.</p>
                }
            </div>
        </div>
    </div>

    <!-- Tabela de recentes -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between">
                <div>
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-clock-history me-2 text-success"></i>Últimos Cadastros
                    </h5>
                    <small class="text-muted">5 tecnologias mais recentes</small>
                </div>
                <a asp-controller="Tecnologias" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    Ver todas
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tecnologia</th>
                                <th>Origem</th>
                                <th>Categoria</th>
                                <th>Data</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Recentes)
                            {
                                <tr>
                                    <td class="fw-medium">@t.Nome</td>
                                    <td><span class="badge bg-secondary">@t.OrigemMissao</span></td>
                                    <td>@t.CategoriaNome</td>
                                    <td class="text-muted small">@t.DataCadastro.ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                            @if (!Model.Recentes.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">Nenhum cadastro ainda.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
