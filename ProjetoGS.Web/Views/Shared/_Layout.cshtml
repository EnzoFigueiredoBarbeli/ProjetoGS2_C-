<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ProjetoGS Space</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark" style="background:linear-gradient(90deg,#0a0a2e,#1a1a5e)">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <i class="bi bi-rocket-takeoff-fill text-warning"></i> ProjetoGS
            <span class="badge bg-warning text-dark ms-1" style="font-size:.6em">SPACE</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tecnologias" asp-action="Index">
                            <i class="bi bi-cpu me-1"></i>Tecnologias
                        </a>
                    </li>
                    @if (User.HasClaim("Perfil", "Administrador"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Tecnologias" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i>Nova Tecnologia
                            </a>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name
                            @if (User.HasClaim("Perfil", "Administrador"))
                            {
                                <span class="badge bg-warning text-dark">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Pesquisador</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Sair
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container-fluid py-4 px-4">
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted py-3 border-top bg-white mt-4">
    <small>
        <i class="bi bi-rocket me-1"></i>
        ProjetoGS Space — FIAP Global Solution 2026 &nbsp;|&nbsp;
        Nova Economia Espacial
    </small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
