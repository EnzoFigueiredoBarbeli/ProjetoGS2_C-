@model ProjetoGS.Web.Models.TecnologiaViewModel
@{
    ViewData["Title"] = "Nova Tecnologia";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-header border-0 py-3" style="background:linear-gradient(90deg,#0a0a2e,#1a1a5e)">
        <h4 class="text-white mb-0 fw-bold">
            <i class="bi bi-plus-circle me-2"></i>Nova Tecnologia Espacial
        </h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-medium">Nome da Tecnologia</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Espuma Viscoelástica"/>
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label fw-medium">Descrição</label>
                <textarea asp-for="Descricao" class="form-control" rows="3"
                          placeholder="Descreva a tecnologia e seu impacto..."></textarea>
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OrigemMissao" class="form-label fw-medium">Origem / Missão</label>
                <input asp-for="OrigemMissao" class="form-control" placeholder="Ex: Apollo, ISS, Artemis"/>
                <span asp-validation-for="OrigemMissao" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AnoDesenvolvimento" class="form-label fw-medium">Ano de Desenvolvimento</label>
                <input asp-for="AnoDesenvolvimento" type="date" class="form-control"/>
                <span asp-validation-for="AnoDesenvolvimento" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="CategoriaId" class="form-label fw-medium">Categoria de Impacto</label>
                <select asp-for="CategoriaId" class="form-select">
                    <option value="">Selecione...</option>
                    <option value="1">Saúde</option>
                    <option value="2">Agricultura</option>
                    <option value="3">Consumo</option>
                    <option value="4">Meio Ambiente</option>
                    <option value="5">Comunicação</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold">
                    <i class="bi bi-save me-2"></i>Salvar Tecnologia
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
