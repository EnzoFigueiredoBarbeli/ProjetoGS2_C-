@model List<ProjetoGS.Web.Models.TecnologiaViewModel>
@{
    ViewData["Title"] = "Tecnologias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0"><i class="bi bi-cpu me-2 text-primary"></i>Tecnologias Espaciais</h2>
        <small class="text-muted">Inovações derivadas da exploração do espaço</small>
    </div>
    @if (User.HasClaim("Perfil", "Administrador"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Nova Tecnologia
        </a>
    }
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Origem / Missão</th>
                        <th>Categoria</th>
                        <th>Cadastrado em</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="text-muted small">@t.Id</td>
                            <td class="fw-medium">@t.Nome</td>
                            <td><span class="badge bg-secondary">@t.OrigemMissao</span></td>
                            <td>
                                <span class="badge rounded-pill" style="background:#e8f4fd;color:#0d6efd">
                                    @t.CategoriaNome
                                </span>
                            </td>
                            <td class="text-muted small">@t.DataCadastro.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.HasClaim("Perfil", "Administrador"))
                                {
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Nenhuma tecnologia cadastrada ainda.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
