@model ProjetoGS.Web.Models.TecnologiaViewModel
@{
    ViewData["Title"] = Model.Nome;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
</div>

<div class="card border-0 shadow-sm" style="max-width:700px">
    <div class="card-header border-0 py-3" style="background:linear-gradient(90deg,#0a0a2e,#1a1a5e)">
        <h4 class="text-white mb-0 fw-bold">
            <i class="bi bi-cpu me-2"></i>@Model.Nome
        </h4>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Descrição</dt>
            <dd class="col-sm-8">@Model.Descricao</dd>

            <dt class="col-sm-4 text-muted">Origem / Missão</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary fs-6">@Model.OrigemMissao</span></dd>

            <dt class="col-sm-4 text-muted">Categoria</dt>
            <dd class="col-sm-8">
                <span class="badge rounded-pill" style="background:#e8f4fd;color:#0d6efd;font-size:.9em">
                    @Model.CategoriaNome
                </span>
            </dd>

            <dt class="col-sm-4 text-muted">Ano de Desenvolvimento</dt>
            <dd class="col-sm-8">@Model.AnoDesenvolvimento.Year</dd>

            <dt class="col-sm-4 text-muted">Data de Cadastro</dt>
            <dd class="col-sm-8 text-muted">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    @if (User.HasClaim("Perfil", "Administrador"))
    {
        <div class="card-footer bg-white border-0 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Excluir
            </a>
        </div>
    }
</div>
